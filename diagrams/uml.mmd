classDiagram
    %% PawPal+ working UML draft — update this as the implementation evolves.

    class Owner {
        +str owner_id
        +str name
        +dict preferences
        +List~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet_id) void
        +get_pets() List~Pet~
    }

    class Pet {
        +str pet_id
        +str name
        +str species
        +str breed
        +str owner_id
        +List~Task~ tasks
        +add_task(task) void
        +remove_task(task_id) void
        +get_tasks() List~Task~
    }

    class Task {
        +str task_id
        +str title
        +int duration_minutes
        +Priority priority
        +str pet_id
        +time preferred_time
        +bool completed
        +mark_complete() void
        +mark_incomplete() void
    }

    class Scheduler {
        +Owner owner
        +int available_minutes
        +build_schedule() List~Task~
        +explain_plan(schedule) str
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    Owner "1" --> "many" Pet : owns
    Pet "1" --> "many" Task : has
    Scheduler --> Owner : builds plan for
    Task --> Priority : uses
